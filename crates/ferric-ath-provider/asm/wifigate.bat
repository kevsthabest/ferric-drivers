@ECHO OFF
REM Cold boot diagnostic only; no FERRIC.JLM or existing CardBus owner.
CBPROBE > CBPRE.TXT
JLOAD FRES.JLM
JLOAD CARDBUS.JLM
JLOAD ATH5K.JLM
ATHDIAG > WIFIGATE.TXT
ATHSCAN >> WIFIGATE.TXT
ATHINIT >> WIFIGATE.TXT
ATHSTOP >> WIFIGATE.TXT
JLOAD -u ATH5K.JLM
JLOAD -u CARDBUS.JLM
JLOAD -u FRES.JLM
ATHDIAG >> WIFIGATE.TXT
CBPROBE > CBPOST.TXT
TYPE WIFIGATE.TXT
ECHO Save CBPRE.TXT, CBPOST.TXT and WIFIGATE.TXT.
